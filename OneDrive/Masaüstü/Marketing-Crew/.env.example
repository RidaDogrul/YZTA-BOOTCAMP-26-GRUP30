# ============================================
# API Keys Configuration
# ============================================
# Bu dosyayı .env olarak kopyalayın ve kendi API key'lerinizi ekleyin
# NOT: Hugging Face'te deploy ederken bu dosya KULLANILMAZ!
# Hugging Face'te Space Settings → Repository Secrets kullanın

# Google Gemini API Key (Zorunlu)
# https://makersuite.google.com/app/apikey adresinden alabilirsiniz
GEMINI_API_KEY=your_gemini_api_key_here

# SerperDev API Key (Opsiyonel - Web araması için)
# https://serper.dev/ adresinden alabilirsiniz
SERPER_API_KEY=your_serper_api_key_here

# OpenAI API Key (Opsiyonel - Alternatif LLM için)
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Hugging Face Deployment Notları
# ============================================
# 
# Hugging Face'te deploy ederken:
# 1. Bu .env dosyasını yüklemeyin!
# 2. Space Settings'e gidin
# 3. Repository secrets bölümünü bulun
# 4. Her API key'i ayrı ayrı secret olarak ekleyin:
#    - Name: GEMINI_API_KEY
#    - Value: [API key değeriniz]
# 5. Space'i restart edin
#
# Daha fazla bilgi için DEPLOYMENT_GUIDE.md dosyasına bakın
